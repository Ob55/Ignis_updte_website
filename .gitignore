# ---- dependencies ----
/node_modules
.pnp
.pnp.js

# ---- build output (generated by `npm run build`, never committed) ----
/dist
/.ssr-dist
/build
/out
/.next
*.tsbuildinfo
next-env.d.ts

# ---- environment / secrets ----
