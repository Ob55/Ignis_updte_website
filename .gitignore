.env
.env.*
!.env.example

# ---- local tooling / caches ----
/.vercel
/.verify/
/GATES.md
/coverage
/.vite
*.local

# ---- logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- editor / OS ----
.DS_Store
Thumbs.db
.idea
*.swp

# ---- working files not part of the site ----
logo-src.png
