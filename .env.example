# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Everything WITHOUT the VITE_ prefix is server-only (scripts/ and api/) and is
# never bundled into the client. Set these in Vercel Project Settings too.

# Google Analytics 4 Measurement ID. Leave unset to disable analytics.
VITE_GA_ID=G-XXXXXXXXXX

# SMTP (server-only) — used by api/assessment.js and scripts/send-*.mjs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@ignis-innovation.com
SMTP_PASS=your-app-password
SMTP_FROM="Ignis Innovation <info@ignis-innovation.com>"

# Where assessment enquiries are routed
LEAD_TO=jwanjiku@ignis-innovation.com,eooro@ignis-innovation.com
LEAD_CC=bmwangi@ignis-innovation.com
