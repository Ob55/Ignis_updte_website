# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Everything WITHOUT the VITE_ prefix is server-only (scripts/ and api/) and is
# never bundled into the client. Set these in Vercel Project Settings too.

# Google Analytics 4 Measurement ID. Leave unset to disable analytics.
VITE_GA_ID=G-XXXXXXXXXX

# SMTP (server-only) — used by api/assessment.js and scripts/send-*.mjs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@ignis-innovation.com
SMTP_PASS=your-app-password
SMTP_FROM="Ignis Innovation <info@ignis-innovation.com>"

# Where assessment enquiries are routed
LEAD_TO=jwanjiku@ignis-innovation.com,eooro@ignis-innovation.com
LEAD_CC=bmwangi@ignis-innovation.com

# Optional: extra Origins allowed to POST the form (comma-separated). The
# production domain, www, localhost and *.vercel.app are always allowed.
ALLOWED_ORIGINS=

# Optional but recommended: durable, distributed rate limiting for /api/assessment.
# Create a free Upstash Redis DB (https://console.upstash.com) and paste its REST
# URL + token. Without these the endpoint falls back to per-instance limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Igni chat assistant (server-only) — used by api/chat.js for complex questions.
# Simple questions are answered in the browser from the site content and never
# use this key. Get one at https://platform.claude.com/ and set it in Vercel too.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace: the workspace ID (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Optional: max AI answers per day across the whole site (needs Upstash above).
IGNI_DAILY_CAP=
